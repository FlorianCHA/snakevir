R1list=expand(f"{output_directory}/01_read_processing/09_viral_reads/{{smp}}_viral_reads_1.fastq",smp=SAMPLES)
R2list=expand(f"{output_directory}/01_read_processing/09_viral_reads/{{smp}}_viral_reads_2.fastq",smp=SAMPLES)
PElist=expand(f"{output_directory}/01_read_processing/09_viral_reads/{{smp}}_viral_reads_wi.fastq",smp=SAMPLES)


rule Megahit_Viral_Assembly:
    input:
        R1s = expand(f"{output_directory}/01_read_processing/09_viral_reads/{{smp}}_viral_reads_1.fastq",smp=SAMPLES),
        R2s = expand(f"{output_directory}/01_read_processing/09_viral_reads/{{smp}}_viral_reads_2.fastq",smp=SAMPLES),
        PEs = expand(f"{output_directory}/01_read_processing/09_viral_reads/{{smp}}_viral_reads_wi.fastq",smp=SAMPLES)
    params:
        prefix=f"{output_directory}/02_assembly_results",
        tmp=f"{output_directory}/02_assembly_results_tmp",
        commaR1s = ",".join(R1list),
        commaR2s = ",".join(R2list),
        commaPEs = ",".join(PElist),
        RUN=f'{RUN}_viral'
    output:
        assembly = f"{output_directory}/02_assembly_results/{RUN}_viral.contigs.fa"
    log:
        f"{output_directory}/logs/02_assembly_results/Megahit_{RUN}.log"
    threads: threads_Megahit_Assembly
    envmodules: config['module_file']
    shell:
        """
        if [ -e {params.tmp} ]; then rm -rf {params.tmp}; fi 
        megahit -t {threads}  --mem-flag 2 -m 1 -1 {params.commaR1s} -2 {params.commaR2s} -r {params.commaPEs} -o {params.tmp} --out-prefix {params.RUN} --continue  2> {log}
        rm -rf {params.prefix}; mv {params.tmp} {params.prefix}
        """

rule Cap3_Viral_Assembly:
    input:
        raw_assembly = rules.Megahit_Viral_Assembly.output.assembly
    output:
        assembly = f"{output_directory}/02_assembly_results/{RUN}_viral_Assembly_results",
        contig = f"{output_directory}/02_assembly_results/{RUN}_viral.contigs.fa.cap.contigs",
        sig = f"{output_directory}/02_assembly_results/{RUN}_viral.contigs.fa.cap.singlets"
    log:
        f"{output_directory}/logs/02_assembly_results/cap3_{RUN}.log"
    envmodules: config['module_file']
    shell:
        """
        cap3 {input.raw_assembly}>{output.assembly} 2> {log}
        """

rule Merge_Mega_cap_Viral_contigs:
    input:
        contig = rules.Cap3_Viral_Assembly.output.contig,
        sig = rules.Cap3_Viral_Assembly.output.sig
    output:
        final_assembly = f"{output_directory}/02_assembly_results/{RUN}_viral_contigs_assembly_results.fa"
    envmodules: config['module_file']
    shell:
        """
        cat {input.contig} {input.sig} > {output.final_assembly}
        """

rule Assembly_informations:
    input:
        assembly = rules.Merge_Mega_cap_Viral_contigs.output.final_assembly
    output:
        stat_assembly = f"{output_directory}/logs/02_assembly_results/logsAssembly/{RUN}_viral_assembly_stats.txt"
    envmodules: config['module_file']
    shell:
        """
        bioawk -c fastx '{{ print $name, length($seq) }}' {input.assembly} | sed 's/      / /g' > {output.stat_assembly}
        """

rule Index_Assembly:
    input:
        assembly = rules.Merge_Mega_cap_Viral_contigs.output.final_assembly
    output:
        index = f"{output_directory}/02_assembly_results/{RUN}_viral_contigs_assembly_results.fa.bwt"
    envmodules: config['module_file']
    shell:
        """
        bwa index {input.assembly} > {output.index}
        """
